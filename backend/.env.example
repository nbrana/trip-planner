# Copy to backend/.env and fill in. Everything is optional for local dev with sample data.

# NJ Transit developer portal (https://developer.njtransit.com) - used only by scripts/fetch_gtfs.py
NJT_USERNAME=
NJT_PASSWORD=
# NJT_BUS_API_BASE=https://pcsdata.njtransit.com/api/GTFSG2
# Live predictions/vehicles/alerts (on automatically when credentials are set)
# REALTIME_ENABLED=true
# REALTIME_POLL_S=30
# ALERTS_POLL_S=300

# Identify your app to OpenStreetMap services (Nominatim requires a real contact).
USER_AGENT=nj-trip-planner/0.1 (contact: you@example.com)

# Data files (default: data/njt_bus_gtfs.zip and data/park_rides.json if present, else sample data)
# GTFS_PATH=data/njt_bus_gtfs.zip
# PARK_RIDE_PATH=data/park_rides.json

# Real street routing for drive times and walk/drive leg shapes (public OSRM servers, no key).
# USE_OSRM=true

# Routing model tuning
# WALK_SPEED_MPS=1.3
# DRIVE_SPEED_MPS=11.0
# PARK_BUFFER_S=300
# PARK_RIDE_WALK_M=500
# MAX_TRANSFER_WALK_M=400
